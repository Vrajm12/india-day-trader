{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nse-500-alerts",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "28 3 * * 1-5",
      "12 4 * * 1-5",
      "33 9 * * 1-5",
      "5 10 * * 1-5"
    ]
  }
}
